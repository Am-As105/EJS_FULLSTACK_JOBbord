<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mes offres suivies - Portail Stages</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="public/css/style.css">
</head>
<body>

    <!-- Header -->
    <%-   include('../componnents/header')>

    <!-- Main Content -->
    <main class="main-content">
        <div class="container">
            
            <div class="page-header-title">
                <div class="title-with-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg>
                    <h1 class="page-title">Mes offres suivies</h1>
                </div>
                <p class="page-subtitle">Offres sauvegardées</p>
            </div>

            <div class="jobs-grid">
                <!-- Card 1 -->
                <article class="job-card">
                    <div class="card-header">
                        <div>
                            <h3 class="job-title">Développeur Front-End React</h3>
                            <p class="company-name">Nexalab</p>
                        </div>
                        <button class="btn-remove" aria-label="Retirer des offres suivies">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                        </button>
                    </div>
                    
                    <div class="job-meta-row">
                        <div class="job-location">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                            Paris
                        </div>

                        <div class="job-badge-wrapper">
                            <span class="badge badge-stage">Stage</span>
                        </div>
                    </div>

                    <div class="card-footer">
                        <a href="offre-detail.html" class="btn-link">
                            Voir l'offre 
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                        </a>
                    </div>
                </article>

                <!-- Card 2 -->
                <article class="job-card">
                    <div class="card-header">
                        <div>
                            <h3 class="job-title">Data Analyst Junior</h3>
                            <p class="company-name">FinSight Analytics</p>
                        </div>
                        <button class="btn-remove" aria-label="Retirer des offres suivies">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                        </button>
                    </div>
                    
                    <div class="job-meta-row">
                        <div class="job-location">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                            Lyon
                        </div>

                        <div class="job-badge-wrapper">
                            <span class="badge badge-stage" style="background-color: #f1f5f9; color: #475569;">Alternance</span>
                        </div>
                    </div>

                    <div class="card-footer">
                        <a href="offre-detail.html" class="btn-link">
                            Voir l'offre 
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                        </a>
                    </div>
                </article>

                <!-- Card 3 -->
                <article class="job-card">
                    <div class="card-header">
                        <div>
                            <h3 class="job-title">UX/UI Designer</h3>
                            <p class="company-name">Atelier Pixel</p>
                        </div>
                        <button class="btn-remove" aria-label="Retirer des offres suivies">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                        </button>
                    </div>
                    
                    <div class="job-meta-row">
                        <div class="job-location">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                            Nantes
                        </div>

                        <div class="job-badge-wrapper">
                            <span class="badge badge-stage" style="background-color: #f1f5f9; color: #475569;">Alternance</span>
                        </div>
                    </div>

                    <div class="card-footer">
                        <a href="offre-detail.html" class="btn-link">
                            Voir l'offre 
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                        </a>
                    </div>
                </article>
            </div>

        </div>
    </main>

    <!-- Footer -->
       <%-   include('../componnents/footer')>


</body>
</html>





